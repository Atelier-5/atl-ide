  "cards": [
    {
      "dot": "emerald",
      "title": "The contract: atl-thymio/0.1",
      "items": [
        "Topics under /thymio_1/: prox/horizontal (7), prox/ground (2), imu, acc, wheels, odom; cmd_vel, leds/top, estop",
        "The gateway names it in every answer (X-ATL-Contract) and serves the robot's A-Box at /robot.ttl",
        "The physical Thymio will offer the same topics later"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "The gateway answers this PC only: a foreign Origin or Host is refused",
        "No driving by hand while a behaviour runs; reset stops the robot first",
        "The E-stop and a 0.5 s watchdog live in the driver, the lowest level"
      ]
    },
    {
      "dot": "violet",
      "title": "Later",
      "items": [
        "Blockly to program the robot and the scene",
        "The real Thymio behind a Raspberry Pi backpack, the same contract",
        "The Atelier-5 cloud link (the edge layer is in place, unlinked)"
      ]
    }
