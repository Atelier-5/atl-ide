    "quality_profile": "showcase",
    "output": "atl/static/how.html",
    "views": [
      {
        "id": "sense",
        "label": "See the sensors",
        "focus": [
          "person",
          "page",
          "app",
          "gateway",
          "drivers",
          "webots"
        ],
        "note": "Webots runs the table. The driver publishes what the Thymio senses; the gateway hands it to the page about 30 times a second."
      },
      {
        "id": "drive",
        "label": "Drive it by hand",
        "focus": [
          "person",
          "page",
          "app",
          "gateway",
          "drivers"
        ],
        "note": "The arrow pad becomes cmd_vel. A watchdog stops the wheels within 0.5 s; the E-stop holds them whatever else is sent."
      },
      {
        "id": "behave",
        "label": "A built-in behaviour",
        "focus": [
          "page",
          "gateway",
          "behaviours",
          "drivers"
        ],
        "note": "Friendly, Explorer and the others read the sensors and write cmd_vel and the LED, exactly as a young person's program will."
      },
      {
        "id": "prepare",
        "label": "Prepare the table",
        "focus": [
          "app",
          "world",
          "webots"
        ],
        "note": "world.py writes table.wbt and is never edited by hand: every later starting world is a variation of it."
      },
      {
        "id": "agent",
        "label": "An agent helps",
        "focus": [
          "agent",
          "mcp",
          "ontology",
          "page"
        ],
        "note": "The agent reads freely. It checks a command against the ontology, then proposes it; a facilitator confirms it on the page."
      }
    ]
  },
