{
  "schema_version": 1,
  "diagram_type": "class",
  "meta": {
    "title": "atl-ide data model: the robot ontology",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "atl/static/model.html"
  },
  "layout": {
    "mode": "grid"
  },
  "types": [
    {
      "id": "command",
      "label": "atl:Command",
      "kind": "class",
      "sublabel": "9 in the A-Box",
      "row": 0,
      "col": 0,
      "attributes": [
        {
          "name": "schema:name",
          "type": "drive, behaviour, button, …",
          "visibility": "public"
        },
        {
          "name": "route",
          "type": "/api/robot/…",
          "visibility": "public"
        },
        {
          "name": "needsConfirmation",
          "type": "true; estop false",
          "visibility": "public"
        },
        {
          "name": "requestClass",
          "type": "atl:…Request",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "thymio",
      "label": "atl:Thymio2",
      "kind": "class",
      "sublabel": "atl:Robot ⊂ sosa:Platform",
      "row": 0,
      "col": 2,
      "attributes": [
        {
          "name": "schema:name",
          "type": "thymio_1",
          "visibility": "public"
        },
        {
          "name": "contract",
          "type": "atl-thymio/0.1",
          "visibility": "public"
        },
        {
          "name": "wheelRadius · wheelTrack",
          "type": "0.021 · 0.10 m",
          "visibility": "public"
        },
        {
          "name": "maxWheelSpeed",
          "type": "9.53 rad/s",
          "visibility": "public"
        },
        {
          "name": "maxLinear · maxAngular",
          "type": "0.2 m/s · 4 rad/s",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "topic",
      "label": "atl:Topic",
      "kind": "record",
      "sublabel": "the ROS 2 contract",
      "row": 0,
      "col": 4,
      "attributes": [
        {
          "name": "path",
          "type": "/thymio_1/…",
          "visibility": "public"
        },
        {
          "name": "messageType",
          "type": "ROS 2 message",
          "visibility": "public"
        },
        {
          "name": "direction",
          "type": "In | Out",
          "visibility": "public"
        },
        {
          "name": "rateHz",
          "type": "≈ 30",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "request",
      "label": "atl:CommandRequest",
      "kind": "abstract",
      "sublabel": "checked by its SHACL shape",
      "row": 1,
      "col": 0,
      "attributes": [
        {
          "name": "linear · angular",
          "type": "±0.2 m/s · ±4 rad/s",
          "visibility": "public"
        },
        {
          "name": "behaviour · button",
          "type": "a SKOS concept",
          "visibility": "public"
        },
        {
          "name": "claps",
          "type": "1 – 3",
          "visibility": "public"
        },
        {
          "name": "red · green · blue",
          "type": "0 – 1",
          "visibility": "public"
        },
        {
          "name": "thing · x · y · yaw",
          "type": "on the table",
          "visibility": "public"
        },
        {
          "name": "engaged · up",
          "type": "boolean",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "sensor",
      "label": "sosa:Sensor",
      "kind": "abstract",
      "sublabel": "what the robot perceives",
      "row": 1,
      "col": 2,
      "attributes": [
        {
          "name": "deviceName · index · side",
          "visibility": "public"
        },
        {
          "name": "aheadOfCentre · leftOfCentre",
          "type": "m, from the PROTO",
          "visibility": "public"
        },
        {
          "name": "rawMin · rawMax · unit",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "measurement",
      "label": "atl:Measurement",
      "kind": "record",
      "sublabel": "measured in the twin",
      "row": 1,
      "col": 3,
      "attributes": [
        {
          "name": "situation",
          "type": "carton at 5.25 cm, …",
          "visibility": "public"
        },
        {
          "name": "value",
          "type": "raw",
          "visibility": "public"
        },
        {
          "name": "measuredOn",
          "type": "date",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "actuator",
      "label": "sosa:Actuator",
      "kind": "abstract",
      "sublabel": "what the robot does",
      "row": 1,
      "col": 4,
      "attributes": [
        {
          "name": "atl:Motor",
          "type": "left, right",
          "visibility": "public"
        },
        {
          "name": "atl:Led",
          "type": "led_top",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "behaviour",
      "label": "atl:Behaviours",
      "kind": "enum",
      "sublabel": "SKOS scheme, with ledColour",
      "row": 2,
      "col": 0,
      "attributes": [
        {
          "name": "explorer",
          "type": "yellow",
          "visibility": "public"
        },
        {
          "name": "friendly",
          "type": "green",
          "visibility": "public"
        },
        {
          "name": "fearful",
          "type": "red",
          "visibility": "public"
        },
        {
          "name": "inspector",
          "type": "light blue",
          "visibility": "public"
        },
        {
          "name": "attentive",
          "type": "dark blue",
          "visibility": "public"
        },
        {
          "name": "obedient",
          "type": "pink",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "prox",
      "label": "atl:ProximitySensor",
      "kind": "class",
      "sublabel": "7, infra-red",
      "row": 2,
      "col": 1,
      "attributes": [
        {
          "name": "raw",
          "type": "0 – 4300",
          "visibility": "public"
        },
        {
          "name": "carton",
          "type": "3186 → 0 by 5.25 cm",
          "visibility": "public"
        },
        {
          "name": "wood",
          "type": "1487 → 0",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "ground",
      "label": "atl:GroundSensor",
      "kind": "class",
      "sublabel": "2, 7.36 cm ahead",
      "row": 2,
      "col": 2,
      "attributes": [
        {
          "name": "raw",
          "type": "0 – 1000",
          "visibility": "public"
        },
        {
          "name": "white table",
          "type": "≈ 765",
          "visibility": "public"
        },
        {
          "name": "black line",
          "type": "≈ 288",
          "visibility": "public"
        },
        {
          "name": "lifted",
          "type": "0",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "acc",
      "label": "atl:Accelerometer",
      "kind": "class",
      "sublabel": "3 axes",
      "row": 2,
      "col": 3,
      "attributes": [
        {
          "name": "acc",
          "type": "raw, ≈ 23 per g",
          "visibility": "public"
        },
        {
          "name": "imu",
          "type": "m/s², robot frame",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "encoder",
      "label": "atl:WheelEncoder",
      "kind": "class",
      "sublabel": "2, one per wheel",
      "row": 2,
      "col": 4,
      "attributes": [
        {
          "name": "wheels",
          "type": "rad/s",
          "visibility": "public"
        },
        {
          "name": "odom",
          "type": "x, y, θ",
          "visibility": "public"
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "accepts",
      "from": "thymio",
      "to": "command",
      "kind": "association",
      "label": "accepts"
    },
    {
      "id": "hosts-sensors",
      "from": "thymio",
      "to": "sensor",
      "kind": "composition",
      "label": "sosa:hosts"
    },
    {
      "id": "hosts-actuators",
      "from": "thymio",
      "to": "actuator",
      "kind": "composition",
      "label": "sosa:hosts"
    },
    {
      "id": "request-of",
      "from": "command",
      "to": "request",
      "kind": "dependency",
      "label": "requestClass"
    },
    {
      "id": "selects",
      "from": "request",
      "to": "behaviour",
      "kind": "dependency",
      "label": "behaviour"
    },
    {
      "id": "measured",
      "from": "sensor",
      "to": "measurement",
      "kind": "association",
      "label": "measured"
    },
    {
      "id": "listens",
      "from": "actuator",
      "to": "topic",
      "kind": "association",
      "label": "listensOn"
    },
    {
      "id": "p-is",
      "from": "prox",
      "to": "sensor",
      "kind": "inheritance"
    },
    {
      "id": "g-is",
      "from": "ground",
      "to": "sensor",
      "kind": "inheritance"
    },
    {
      "id": "a-is",
      "from": "acc",
      "to": "sensor",
      "kind": "inheritance"
    },
    {
      "id": "e-is",
      "from": "encoder",
      "to": "sensor",
      "kind": "inheritance"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "A thin layer over standards",
      "items": [
        "SOSA/SSN for the platform, sensors and actuators; schema.org for names; SKOS for behaviours, buttons and domains",
        "Labels in English, French and German",
        "Sensors publishOn their topic, as the actuators listenOn theirs"
      ]
    },
    {
      "dot": "violet",
      "title": "Two halves",
      "items": [
        "T-Box and SHACL shapes in atl-ide (atl/edge/ontology/)",
        "A-Box in the robot's image, generated from its contract (atl-bot-thymio scripts/make_abox.py), served at GET /robot.ttl"
      ]
    },
    {
      "dot": "amber",
      "title": "How an agent uses it",
      "items": [
        "robot(), sensors(), commands() read the A-Box and the live values",
        "command(name, …) builds the request, SHACL refuses it in the shape's own words, else it becomes a proposal",
        "A facilitator confirms it; the E-stop is never a proposal"
      ]
    }
  ]
}