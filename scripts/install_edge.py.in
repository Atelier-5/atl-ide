#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 D-LAB-5
"""
Install atl-ide @VERSION@ on this computer: Linux, macOS or Windows.

Download this file and the package next to it from the Atelier-5 cloud
(Settings -> Edges -> Install an edge), then, in that folder:

    python3 install_atl.py        (Linux, macOS)
    py install_atl.py             (Windows)

It needs Python 3.10 or newer, nothing else, and does no more than:
  1. checks the package against the SHA-256 the Atelier-5 cloud published
  2. makes a virtualenv in this user's own application-data folder and
     installs the package there (no administrator rights)
  3. writes a start command (atl-ide-start, or .cmd on Windows) and
     starts the edge on http://127.0.0.1:8780 (this computer only)
On its first start the edge fetches what it still lacks; after linking,
what its workshop already knows. Running this again updates the edge.

Without this script, the same by hand:
    python -m venv <folder>/venv
    <folder>/venv/bin/python -m pip install @WHEEL@
    <folder>/venv/bin/python -m atl     (ATL_IDE_EDGE_HOME=<folder> to keep its files there)

Generated by scripts/publish-to-cloud.sh; do not edit the copy in the cloud.
"""

import hashlib
import os
import subprocess
import sys
import time
import urllib.request
import venv
import webbrowser
from pathlib import Path

VERSION = "@VERSION@"
WHEEL = "@WHEEL@"
SHA256 = "@SHA256@"
PORT = int(os.environ.get("ATL_IDE_EDGE_PORT", "8780"))


def say(text=""):
    print(text, flush=True)


def stop(text):
    say("")
    say("  x " + text)
    sys.exit(1)


def data_home():
    if sys.platform == "win32":
        return Path(os.environ.get("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "atl-ide"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "atl-ide"
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "atl-ide"


def running():
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/api/health", timeout=2):
            return True
    except Exception:
        return False


def main():
    say(f"atl-ide {VERSION}")
    if sys.version_info < (3, 10):
        stop(f"Python 3.10 or newer is needed (this is {sys.version.split()[0]}): https://www.python.org/downloads/")
    say(f"  ok Python {sys.version.split()[0]}")

    pkg = Path(__file__).resolve().parent / WHEEL
    if not pkg.is_file():
        stop(f"{WHEEL} must be next to this script: download both from the Atelier-5 cloud.")
    if hashlib.sha256(pkg.read_bytes()).hexdigest() != SHA256:
        stop(f"{WHEEL} does not match its checksum. Download it again from the Atelier-5 cloud.")
    say("  ok package checked (SHA-256)")

    home = Path(os.environ["ATL_IDE_EDGE_HOME"]) if os.environ.get("ATL_IDE_EDGE_HOME") else data_home()
    home.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(home, 0o700)
    except OSError:
        pass
    env_dir = home / "venv"
    py = env_dir / ("Scripts/python.exe" if sys.platform == "win32" else "bin/python")
    if not py.exists():
        venv.EnvBuilder(with_pip=True).create(env_dir)
    clean = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    say("  .. installing (the first time this downloads its libraries, a few minutes)")
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", "--upgrade", "pip"], check=True, env=clean)
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", "--upgrade", "--force-reinstall", "--no-deps", str(pkg)], check=True, env=clean)
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", str(pkg)], check=True, env=clean)
    say(f"  ok installed in {home}")

    if sys.platform == "win32":
        start = home / "atl-ide-start.cmd"
        start.write_text(f'@echo off\r\nset PYTHONPATH=\r\nset ATL_IDE_EDGE_HOME={home}\r\n"{py}" -m atl --port {PORT} %*\r\n')
    else:
        bin_dir = Path.home() / ".local" / "bin"
        bin_dir.mkdir(parents=True, exist_ok=True)
        start = bin_dir / "atl-ide-start"
        start.write_text(f'#!/bin/sh\nunset PYTHONPATH\nexport ATL_IDE_EDGE_HOME="{home}"\nexec "{py}" -m atl --port {PORT} "$@"\n')
        start.chmod(0o755)

    if running():
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/restart", data=b"{}", method="POST",
                                     headers={"Content-Type": "application/json"})
        try:
            urllib.request.urlopen(req, timeout=5)
        except Exception:
            pass
        say("  ok the running edge restarts with the new version")
    else:
        log = open(home / "edge.log", "ab")
        kw = {"creationflags": 0x00000008 | 0x00000200} if sys.platform == "win32" else {"start_new_session": True}
        subprocess.Popen([str(py), "-m", "atl", "--port", str(PORT)],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                         env={**clean, "ATL_IDE_EDGE_HOME": str(home)}, **kw)
        for _ in range(20):
            if running():
                break
            time.sleep(1)
        say("  ok started")
    url = f"http://127.0.0.1:{PORT}/"
    if os.environ.get("DISPLAY") or sys.platform in ("win32", "darwin"):
        webbrowser.open(url)

    say("")
    say(f"Next, in the edge ({url}):")
    say("  1. Connections: + Add connection, with the edge API address from the cloud's About page")
    say("  2. Let an admin of your workshop approve the code on the cloud's /link page")
    say("")
    say(f"Start it again later with: {start}")


if __name__ == "__main__":
    main()
